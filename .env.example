# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://wonder:wonder@localhost:5432/wonder_crm?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Initial passwords for the team in prisma/seed-users.ts (min 8 characters).
# Used only when `npm run db:seed` first creates each account; a person whose
# variable is empty is skipped. Ask everyone to change it after first login.
SEED_PASSWORD_GAUTAMI=""
SEED_PASSWORD_VIREN=""
SEED_PASSWORD_ROHAN=""
SEED_PASSWORD_VINAY=""
SEED_PASSWORD_HARSHAL=""

# Throwaway database for `npm test` (wiped on every run)
TEST_DATABASE_URL="postgresql://wonder:wonder@localhost:5432/wonder_crm_test?schema=public"
