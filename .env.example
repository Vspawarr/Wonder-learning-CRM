# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://wonder:wonder@localhost:5432/wonder_crm?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# The two initial admin (Director) accounts created by `npm run db:seed`.
# An admin whose three values are not all set is skipped. Re-running the seed
# updates name/role but never overwrites an existing password.
ADMIN1_NAME=""
ADMIN1_EMAIL=""
ADMIN1_PASSWORD=""
ADMIN2_NAME=""
ADMIN2_EMAIL=""
ADMIN2_PASSWORD=""
