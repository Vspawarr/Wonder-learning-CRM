// Wonder Learning CRM — Phase 1: Sales & Leads.
//
// Enums hold workflow values the code branches on. Business lists that the
// company may edit (lead sources, designations, publications, follow-up types,
// competitors, lost reasons, states) are plain text validated against
// src/lib/constants.ts, so changing a list never needs a migration.
//
// Later phases plug in without reshaping these tables: School/Order/Service
// add nullable FKs on Opportunity, Task and Activity; Product already carries
// a type for printed material.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Users ─────────────────────────

// Access is defined in src/server/access.ts.
enum Role {
  DIRECTOR // business owner: everything
  ADMIN // manages users, products and cities; sees all sales data
  SALES_HEAD // heads sales: sees and reassigns all sales data
  SALES_MANAGER // sees all sales data
  SALES_EXECUTIVE // sees only own leads, opportunities and tasks
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  mobile       String?
  role         Role
  passwordHash String
  active       Boolean   @default(true)
  /// Wrong passwords in a row; 5 locks the account for 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordResets PasswordReset[]

  leadsAssigned      Lead[]                   @relation("LeadAssignedTo")
  leadsCreated       Lead[]                   @relation("LeadCreatedBy")
  oppsOwned          Opportunity[]            @relation("OpportunityOwner")
  clientsOwned       Client[]                 @relation("ClientOwner")
  clientsCreated     Client[]                 @relation("ClientCreatedBy")
  oppsCreated        Opportunity[]            @relation("OpportunityCreatedBy")
  tasksAssigned      Task[]                   @relation("TaskAssignee")
  tasksCreated       Task[]                   @relation("TaskCreatedBy")
  quotationsPrepared Quotation[]
  salesOrdersCreated SalesOrder[]
  invoicesCreated    Invoice[]
  paymentsRecorded   Payment[]                @relation("PaymentRecordedBy")
  poFilesUploaded    PurchaseOrderFile[]
  creditNotesCreated CreditNote[]
  activities         Activity[]
  stageChanges       OpportunityStageChange[]
  dispatchesCreated  Dispatch[]
  filesUploaded      ClientFile[]
  targets            Target[]
  paymentsApproved   Payment[]                @relation("PaymentApprovedBy")
  expensesOwn        Expense[]                @relation("ExpenseOf")
  expensesCreated    Expense[]                @relation("ExpenseCreatedBy")
  expensesDecided    Expense[]                @relation("ExpenseDecidedBy")
  expensesReimbursed Expense[]                @relation("ExpenseReimbursedBy")
  advancesHeld       EmployeeAdvance[]        @relation("AdvanceTo")
  advancesEntered    EmployeeAdvance[]        @relation("AdvanceEnteredBy")
  companyEntries     CompanyEntry[]           @relation("EntryCreatedBy")
  entriesDecided     CompanyEntry[]           @relation("EntryDecidedBy")
  billsCreated       Bill[]                   @relation("BillCreatedBy")
  billsDecided       Bill[]                   @relation("BillDecidedBy")
  billPayments       BillPayment[]
  salaries           SalaryPayment[]          @relation("SalaryOf")
  salariesCreated    SalaryPayment[]          @relation("SalaryCreatedBy")
  salariesDecided    SalaryPayment[]          @relation("SalaryDecidedBy")
  transfers          AccountTransfer[]
  bookMatches        BookMatch[]
}

// ───────────────────────── Masters ─────────────────────────

enum ProductType {
  SERVICE
  MATERIAL
}

model Product {
  id        String      @id @default(cuid())
  code      String      @unique // P01, P02 … (M01 … for printed material in Phase 3)
  name      String
  type      ProductType
  category  String?
  price     Decimal?    @db.Decimal(12, 2) // school price (SP), null until real pricing is entered
  /// Printed MRP from the client's price list; fills the MRP column on quotations.
  mrp       Decimal?    @db.Decimal(12, 2)
  gstRate   Decimal?    @db.Decimal(5, 2) // percent, e.g. 18.00
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  /// What's inside a kit: [{ title, items }] as on the client's checklist ("Common Kit | 19 objects" …).
  contents  Json?
  /// Heading colour on the kit checklist PDF, e.g. "#F08A1C".
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  leadInterests    LeadInterest[]
  opportunityItems OpportunityItem[]
  quotationItems   QuotationItem[]
  salesOrderItems  SalesOrderItem[]
  invoiceItems     InvoiceItem[]
}

// States and cities are managed in-app (Settings → Locations). They are the single
// list behind the lead form's State/City dropdowns, the Excel template and the upload check.
model State {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  cities City[]
}

model City {
  id        String  @id @default(cuid())
  stateName String
  state     State   @relation(fields: [stateName], references: [name], onUpdate: Cascade)
  name      String
  active    Boolean @default(true)

  @@unique([stateName, name])
}

// ───────────────────────── Leads ─────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED // set by the system when an Opportunity is created
  DISQUALIFIED // set by the Disqualify action (reason required)
}

enum Temperature {
  HOT
  WARM
  COLD
}

model Lead {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement()) // displayed as L-<number>

  // Basic information
  schoolName  String
  contactName String // Owner / contact person
  designation String? // DESIGNATIONS
  mobile      String
  email       String?
  state       String // STATES
  city        String
  area        String? // Area / location
  address     String?

  // School details
  currentCurriculum String? // free text
  studentStrength   Int?
  branches          Int?

  // Lead
  source        String // SOURCES
  referenceName String? // only when source ∈ REF_SOURCES
  remarks       String?

  // CRM control
  status       LeadStatus @default(NEW)
  assignedToId String
  assignedTo   User       @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User       @relation("LeadCreatedBy", fields: [createdById], references: [id])

  // Follow-up
  nextFollowUpDate DateTime? @db.Date // required on create; cleared once closed
  followUpType     String? // FOLLOWUP_TYPES
  followUpRemark   String?

  // Outcome
  disqualifyReason  String? // LOST_REASONS
  disqualifyRemarks String?
  disqualifiedAt    DateTime?
  convertedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interests     LeadInterest[]
  opportunities Opportunity[]
  tasks         Task[]
  activities    Activity[]
  quotations    Quotation[]
  expenses      Expense[]

  @@index([assignedToId, status])
  @@index([nextFollowUpDate])
  @@index([createdAt])
}

model LeadInterest {
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@id([leadId, productId])
}

// ───────────────────────── Opportunities ─────────────────────────

enum OpportunityStage {
  INTERESTED
  DEMO_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model Opportunity {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement()) // displayed as O-<number>

  leadId String? // nullable so Phase 2 can open one for an existing school
  lead   Lead?   @relation(fields: [leadId], references: [id])
  client Client? // set once a won deal is converted to a client

  /// Next academic year's reorder from an existing client (no lead, no new client on win).
  renewalOfId  String?
  renewalOf    Client? @relation("Renewals", fields: [renewalOfId], references: [id], onDelete: SetNull)
  /// e.g. "2027-28"
  academicYear String?

  schoolName        String
  stage             OpportunityStage @default(INTERESTED)
  probability       Int // auto-set from STAGE_PROBABILITY on every stage change
  /// "Category" on screen: Hot / Warm / Cold, chosen when the lead is converted.
  temperature       Temperature      @default(WARM)
  expectedValue     Decimal?         @db.Decimal(14, 2) // ₹, typed by the salesperson; drives pipeline totals
  expectedCloseDate DateTime?        @db.Date
  competitor        String? // COMPETITORS
  competitorNote    String? // which one, when competitor is "Other" (R41)
  decisionMaker     String?
  nextAction        String?
  nextActionDate    DateTime?        @db.Date

  lostReason  String? // LOST_REASONS, required when stage = LOST
  lostRemarks String?
  closedAt    DateTime? // set on WON or LOST

  ownerId     String
  owner       User   @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User   @relation("OpportunityCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        OpportunityItem[]
  stageChanges OpportunityStageChange[]
  quotations   Quotation[]
  tasks        Task[]
  activities   Activity[]

  @@index([ownerId, stage])
  @@index([leadId])
}

model OpportunityItem {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  qty           Int         @default(1)
  unitPrice     Decimal?    @db.Decimal(12, 2) // snapshot of Product.price when added; null if unpriced

  @@unique([opportunityId, productId])
}

model OpportunityStageChange {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  changedById   String
  changedBy     User              @relation(fields: [changedById], references: [id])
  changedAt     DateTime          @default(now())

  @@index([opportunityId, changedAt])
}

// ───────────────────────── Tasks & activity ─────────────────────────

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id             String       @id @default(cuid())
  type           String // TASK_TYPES: follow-up types or own to-do types
  title          String
  remark         String?
  dueDate        DateTime     @db.Date
  /// Optional time of day, "HH:MM" (24h), e.g. for an internal meeting.
  dueTime        String?
  postponedCount Int          @default(0)
  postponeReason String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  outcome        String?
  completedAt    DateTime?
  isAuto         Boolean      @default(false) // created by the system, not a person

  assigneeId  String
  assignee    User   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  // What the task is about — later phases add serviceId, invoiceId…
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// "Deposit cheque" reminders belong to the cheque payment.
  paymentId     String?
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status, dueDate])
  @@index([clientId])
  @@index([leadId])
  @@index([opportunityId])
}

enum ActivityType {
  PHONE
  WHATSAPP
  EMAIL
  MEETING
  SITE_VISIT
  NOTE
  SYSTEM // automatic events: created, converted, stage changed, disqualified…
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  subject    String
  summary    String?
  nextAction String?
  occurredAt DateTime     @default(now())

  byId String
  by   User   @relation(fields: [byId], references: [id])

  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([clientId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([opportunityId, occurredAt])
  @@index([byId, occurredAt])
}

// ───────────────────────── Clients ─────────────────────────

enum ClientStatus {
  ONBOARDING // just converted from a won deal
  ACTIVE // onboarding complete
}

// A school that has signed up, created from a won opportunity ("Convert to client").
// Phase 2 extends this with the full onboarding process, agreements and orders.
model Client {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement()) // displayed as C-<number>

  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  // Copied from the lead at conversion so the client stands on its own.
  schoolName        String
  contactName       String
  designation       String?
  mobile            String
  email             String?
  state             String
  city              String
  area              String?
  address           String?
  currentCurriculum String?
  studentStrength   Int?
  branches          Int?

  status                ClientStatus @default(ONBOARDING)
  onboardingCompletedAt DateTime?

  ownerId     String // account owner, initially the deal owner
  owner       User   @relation("ClientOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User   @relation("ClientCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       Task[]
  activities  Activity[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]
  payments    Payment[]
  creditNotes CreditNote[]
  dispatches  Dispatch[]
  files       ClientFile[]
  expenses    Expense[]
  contacts    ClientContact[]
  renewals    Opportunity[]   @relation("Renewals")

  @@index([ownerId, status])
}

// ───────────────────────── Quotations ─────────────────────────

enum QuotationStatus {
  DRAFT // editable
  SENT // locked; revise by creating a new quotation
}

model Quotation {
  id     String @id @default(cuid())
  number String @unique // QUO/2026/07/005 — running number per month
  year   Int
  month  Int
  seq    Int

  // New business is quoted on an opportunity; repeat orders on the client. A quotation made while the
  // school is still a lead keeps leadId and gets the opportunity's id when the lead converts.
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date         DateTime @db.Date
  validityDays Int
  toLine       String // "The Director"
  schoolName   String
  address      String?

  status     QuotationStatus @default(DRAFT)
  sentAt     DateTime?
  sentVia    String? // download | whatsapp | email
  emailedTo  String?
  shareToken String          @unique // secret for the WhatsApp link to the PDF

  /// Our PO number for the school's PO template, e.g. PO/2627/93 (given the first time the template is saved).
  poNumber  String? @unique
  /// What the PO template prints besides the quotation: kits, requisitioner, delivery date, remarks,
  /// customisation and the cheque plan (see src/server/finance/po.ts → PoDetails).
  poDetails Json?

  preparedById String
  preparedBy   User   @relation(fields: [preparedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       QuotationItem[]
  salesOrders SalesOrder[]

  @@unique([year, month, seq])
  @@index([leadId])
  @@index([opportunityId])
  @@index([clientId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String
  mrp         Decimal   @db.Decimal(12, 2) // typed on each quotation
  price       Decimal   @db.Decimal(12, 2) // per kit as the school sees it, transport included
  /// Transport per kit for the school's location, already inside price. Internal only: never printed (R29).
  transport   Decimal   @default(0) @db.Decimal(12, 2)
  /// A kit changed for this school: { removed: [item names], added: [{ productId, name, sp, mrp }] } (R29).
  kit         Json?
  sortOrder   Int
}

// Small editable settings, e.g. the quotation's standard pages ("quotation.content").
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ───────────────────────── Orders, invoices, payments ─────────────────────────

enum SalesOrderStatus {
  CONFIRMED
  DELIVERED
  CANCELLED
}

model SalesOrder {
  id     String @id @default(cuid())
  number String @unique // SO/2026/10/001
  year   Int
  month  Int
  seq    Int

  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotationId String? // the quotation it was made from, if any
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  date             DateTime         @db.Date
  expectedDelivery DateTime?        @db.Date
  deliveredOn      DateTime?        @db.Date
  status           SalesOrderStatus @default(CONFIRMED)
  notes            String?

  /// The school's purchase order (also printed on the invoice).
  poNumber String?
  poDate   DateTime?          @db.Date
  poFile   PurchaseOrderFile?

  /// Proforma invoice PI/YYYY/MM/NNN, given the first time it is printed.
  proformaNumber String?    @unique
  proformaDate   DateTime?  @db.Date
  advances       Payment[]
  dispatches     Dispatch[]

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    SalesOrderItem[]
  invoices Invoice[]

  @@unique([year, month, seq])
  @@index([clientId])
}

/// The signed PO the school sent back (PDF or photo), kept apart so order lists don't load it.
model PurchaseOrderFile {
  id           String     @id @default(cuid())
  salesOrderId String     @unique
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  fileName     String
  contentType  String
  size         Int
  data         Bytes
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime   @default(now())
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id])
  description  String
  qty          Int // number of kits
  price        Decimal    @db.Decimal(12, 2) // per kit, before GST
  gstRate      Decimal    @default(0) @db.Decimal(5, 2) // % (0 for educational material)
  sortOrder    Int

  dispatched DispatchItem[]
}

/// Kits sent to the school in one lot (an order can go in several lots).
model Dispatch {
  id           String     @id @default(cuid())
  number       String     @unique // DC/2026/10/001 (delivery challan)
  year         Int
  month        Int
  seq          Int
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  transporter  String?
  docketNo     String?
  vehicleNo    String?
  notes        String?
  /// When the school confirmed receipt.
  receivedOn   DateTime?  @db.Date
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())

  items DispatchItem[]
  files ClientFile[]

  @@unique([year, month, seq])
  @@index([salesOrderId])
}

model DispatchItem {
  id               String         @id @default(cuid())
  dispatchId       String
  dispatch         Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  salesOrderItemId String
  salesOrderItem   SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  qty              Int
}

/// Files kept on a client: documents (agreement, GST certificate…) and proof of delivery.
model ClientFile {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// DOCUMENT_CATEGORIES, or "Proof of delivery"
  category     String
  title        String
  fileName     String
  contentType  String
  size         Int
  data         Bytes
  dispatchId   String?
  dispatch     Dispatch? @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())

  @@index([clientId])
}

/// Extra people at a school (Principal, Accounts…), besides the main contact.
model ClientContact {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  role        String // CONTACT_ROLES
  mobile      String?
  email       String?
  /// Payment reminders and receipts default to this contact.
  forPayments Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([clientId])
}

/// Monthly sales (invoiced) and collection targets per salesperson.
model Target {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "2026-10"
  month      String
  sales      Decimal @default(0) @db.Decimal(14, 2)
  collection Decimal @default(0) @db.Decimal(14, 2)

  @@unique([userId, month])
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

model Invoice {
  id     String @id @default(cuid())
  number String @unique // INV/2026/10/001
  year   Int
  month  Int
  seq    Int

  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  date       DateTime      @db.Date
  dueDate    DateTime      @db.Date
  status     InvoiceStatus @default(ISSUED)
  subtotal   Decimal       @db.Decimal(14, 2)
  gstAmount  Decimal       @db.Decimal(14, 2)
  total      Decimal       @db.Decimal(14, 2)
  shareToken String        @unique // secret for the WhatsApp link to the PDF

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       InvoiceItem[]
  payments    Payment[]
  creditNotes CreditNote[]
  tasks       Task[]

  @@unique([year, month, seq])
  @@index([clientId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  qty         Int
  price       Decimal  @db.Decimal(12, 2)
  gstRate     Decimal  @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(14, 2) // qty × price, before GST
  sortOrder   Int
}

model Payment {
  id           String        @id @default(cuid())
  /// Receipt number like 117/26-27: running per financial year (April–March), as on the client's receipt book.
  /// Given when the payment is approved by Accounts (R36), so rejected entries leave no gaps in the book.
  number       String?       @unique
  year         Int?
  month        Int?
  seq          Int?
  /// Secret for the shareable receipt link /r/<token>.
  shareToken   String        @unique
  /// Set once invoiced. An advance taken on a sales order has no invoice until the order is invoiced.
  invoiceId    String?
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// The order an advance was taken against.
  salesOrderId String?
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(14, 2)
  date         DateTime      @db.Date
  mode         String // PAYMENT_MODES
  reference    String? // cheque no., UTR…
  note         String?
  /// Cheques: bank and the date written on the cheque (a PDC is dated later).
  bank         String?
  chequeDate   DateTime?     @db.Date
  /// RECEIVED / CLEARED count as paid; IN_HAND / DEPOSITED are cheques not yet cleared.
  status       PaymentStatus @default(RECEIVED)
  statusAt     DateTime?
  tasks        Task[]

  /// The company account the money went into (bank / office cash), chosen on approval (R39).
  moneyAccountId String?
  moneyAccount   MoneyAccount? @relation("PaymentInto", fields: [moneyAccountId], references: [id], onDelete: SetNull)

  /// Accounts approval (R36): only APPROVED payments count as received and get a receipt.
  approval     PaymentApproval @default(APPROVED)
  approvedById String?
  approvedBy   User?           @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  rejectReason String?

  recordedById String
  recordedBy   User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([year, month, seq])
  @@index([invoiceId])
  @@index([salesOrderId])
  @@index([clientId, date])
}

enum PaymentApproval {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  RECEIVED
  IN_HAND
  DEPOSITED
  CLEARED
  BOUNCED
}

/// Reduces what a school owes on an invoice (returns, discount, write-off).
model CreditNote {
  id          String   @id @default(cuid())
  number      String   @unique // CN/2026/10/001
  year        Int
  month       Int
  seq         Int
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  reason      String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([year, month, seq])
  @@index([invoiceId])
}

/// One-time "forgot password" link (only the hash of the secret is stored).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ───────────────────────── Expenses (R37) ─────────────────────────

/// Who paid: the employee's own money (reimbursed later), the advance the company gave them, or a company account.
enum ExpensePaidBy {
  OWN
  ADVANCE
  COMPANY
  COMPANY_CARD
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// A spend with its bill: travel, hotel, meals on visits, or company costs (services, licences…).
model Expense {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement()) // shown as E-<number>
  date         DateTime      @db.Date
  category     String // EXPENSE_CATEGORIES
  amount       Decimal       @db.Decimal(12, 2)
  description  String
  city         String?
  paidTo       String? // hotel, vendor…
  paidBy       ExpensePaidBy
  mode         String? // EXPENSE_MODES
  reference    String?
  /// No bill: what the spend was and why there is no bill (R38). Required when no bill is attached.
  noBillReason String?

  /// The employee whose spend it is; empty for a company expense.
  userId   String?
  user     User?   @relation("ExpenseOf", fields: [userId], references: [id])
  /// The school it was for, if any.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId   String?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  status       ExpenseStatus @default(SUBMITTED)
  decidedById  String?
  decidedBy    User?         @relation("ExpenseDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  rejectReason String?

  /// Own-money spends: when Accounts paid the employee back.
  reimbursedAt   DateTime?
  reimbursedById String?
  reimbursedBy   User?     @relation("ExpenseReimbursedBy", fields: [reimbursedById], references: [id])
  reimburseRef   String?

  /// Company account / card that paid (company and card expenses), and the account used to pay the employee back (R39).
  moneyAccountId     String?
  moneyAccount       MoneyAccount? @relation("ExpensePaidFrom", fields: [moneyAccountId], references: [id], onDelete: SetNull)
  reimburseAccountId String?
  reimburseAccount   MoneyAccount? @relation("ExpenseReimbursedFrom", fields: [reimburseAccountId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User          @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  files       ExpenseFile[]

  @@index([userId, date])
  @@index([status])
}

/// Bill photo or PDF (stored in the database, 4 MB max).
model ExpenseFile {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName    String
  contentType String
  size        Int
  data        Bytes
  uploadedAt  DateTime @default(now())
}

enum AdvanceKind {
  GIVEN
  RETURNED
}

/// Money the company gives an employee in advance for spends (or that they give back).
model EmployeeAdvance {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("AdvanceTo", fields: [userId], references: [id])
  kind           AdvanceKind   @default(GIVEN)
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @db.Date
  mode           String?
  reference      String?
  note           String?
  /// Company account the advance was paid from (or returned into) (R39).
  moneyAccountId String?
  moneyAccount   MoneyAccount? @relation("AdvanceAccount", fields: [moneyAccountId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User          @relation("AdvanceEnteredBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([userId, date])
}

// ───────────────────────── Company accounts (R39) ─────────────────────────

enum MoneyAccountKind {
  BANK
  CASH
  CARD
  OTHER
}

/// Where the company's money sits: a bank account, office cash, the company credit card (balance below 0 = card dues).
model MoneyAccount {
  id             String           @id @default(cuid())
  name           String           @unique
  kind           MoneyAccountKind
  /// Last digits / card ending, shown to tell accounts apart.
  number         String?
  openingBalance Decimal          @default(0) @db.Decimal(14, 2)
  openingDate    DateTime         @db.Date
  active         Boolean          @default(true)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())

  payments           Payment[]         @relation("PaymentInto")
  expensesPaid       Expense[]         @relation("ExpensePaidFrom")
  expensesReimbursed Expense[]         @relation("ExpenseReimbursedFrom")
  advances           EmployeeAdvance[] @relation("AdvanceAccount")
  entries            CompanyEntry[]
  transfersOut       AccountTransfer[] @relation("TransferFrom")
  transfersIn        AccountTransfer[] @relation("TransferTo")
  billPayments       BillPayment[]
  salaries           SalaryPayment[]
}

enum MoneyDirection {
  IN
  OUT
}

/// The Director approves outgoing money entered by others (same rule as expenses, R38).
enum SpendApproval {
  PENDING
  APPROVED
  REJECTED
}

/// Other money in or out, not linked to a school: interest, capital, loans, rent, bank charges, GST / TDS paid…
model CompanyEntry {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement()) // M-<number>
  date           DateTime       @db.Date
  direction      MoneyDirection
  category       String // COMPANY_IN_CATEGORIES / COMPANY_OUT_CATEGORIES
  amount         Decimal        @db.Decimal(14, 2)
  party          String?
  reference      String?
  note           String?
  moneyAccountId String?
  moneyAccount   MoneyAccount?  @relation(fields: [moneyAccountId], references: [id], onDelete: SetNull)
  status         SpendApproval  @default(APPROVED)
  decidedById    String?
  decidedBy      User?          @relation("EntryDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  rejectReason   String?
  fileName       String?
  fileType       String?
  fileData       Bytes?
  createdById    String
  createdBy      User           @relation("EntryCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())

  @@index([date])
}

/// Money moved between the company's own accounts (cash deposited, card bill paid from the bank…).
model AccountTransfer {
  id            String       @id @default(cuid())
  date          DateTime     @db.Date
  amount        Decimal      @db.Decimal(14, 2)
  fromAccountId String
  fromAccount   MoneyAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     MoneyAccount @relation("TransferTo", fields: [toAccountId], references: [id])
  reference     String?
  note          String?
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
}

/// A supplier / printing-press / service bill the company has to pay (payables).
model Bill {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement()) // B-<number>
  vendor       String
  billNo       String?
  billDate     DateTime      @db.Date
  dueDate      DateTime?     @db.Date
  category     String // BILL_CATEGORIES
  description  String
  /// Before GST; GST % optional (services with GST).
  amount       Decimal       @db.Decimal(14, 2)
  gstRate      Decimal       @default(0) @db.Decimal(5, 2)
  gstAmount    Decimal       @default(0) @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  status       SpendApproval @default(APPROVED)
  decidedById  String?
  decidedBy    User?         @relation("BillDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  rejectReason String?
  fileName     String?
  fileType     String?
  fileData     Bytes?
  createdById  String
  createdBy    User          @relation("BillCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  payments     BillPayment[]

  @@index([billDate])
}

model BillPayment {
  id             String        @id @default(cuid())
  billId         String
  bill           Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  amount         Decimal       @db.Decimal(14, 2)
  moneyAccountId String?
  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id], onDelete: SetNull)
  mode           String?
  reference      String?
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
}

/// A month's salary paid to one person (a CRM user, or someone without a login, e.g. a driver).
model SalaryPayment {
  id             String        @id @default(cuid())
  /// "2026-10"
  month          String
  userId         String?
  user           User?         @relation("SalaryOf", fields: [userId], references: [id])
  employeeName   String
  gross          Decimal       @db.Decimal(14, 2)
  /// PF, ESI, TDS, professional tax, advance recovered…
  deductions     Decimal       @default(0) @db.Decimal(14, 2)
  net            Decimal       @db.Decimal(14, 2)
  paidOn         DateTime      @db.Date
  moneyAccountId String?
  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id], onDelete: SetNull)
  mode           String?
  reference      String?
  note           String?
  status         SpendApproval @default(APPROVED)
  decidedById    String?
  decidedBy      User?         @relation("SalaryDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  rejectReason   String?
  createdById    String
  createdBy      User          @relation("SalaryCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([month])
}

/// "Matched with the bank statement" ticks in an account book; one per money movement.
model BookMatch {
  /// e.g. "payment:<id>", "bill-payment:<id>", "transfer-in:<id>".
  key       String   @id
  matchedAt DateTime @default(now())
  byId      String
  by        User     @relation(fields: [byId], references: [id])
}
